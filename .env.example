# Copie este archivo como .env (no lo suba a GitHub) y complete los valores.
# En Render defina las mismas variables en Environment.

# ── Guia 9: Backblaze B2 (bucket privado, API S3)
B2_ENABLED=true
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=nombre-de-su-bucket
B2_KEY_ID=keyID-de-la-application-key
B2_APPLICATION_KEY=applicationKey-de-la-application-key

# ── Guia 10: Valkey en Aiven (Service URI con rediss:// = TLS)
VALKEY_ENABLED=true
VALKEY_URI=rediss://default:PASSWORD@HOST:PORT

# ── Guia 11: OpenSearch en Aiven (Service URI de la pestana OpenSearch)
OPENSEARCH_ENABLED=true
OPENSEARCH_URL=https://avnadmin:PASSWORD@HOST:PORT
